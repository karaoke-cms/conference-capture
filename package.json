{
  "name": "metaphorum-conference-capture",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "seed": "bun scripts/seed.ts",
    "import:metaphorum": "bun scripts/import-metaphorum.ts",
    "scheduler": "bun scripts/scheduler.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --filter '@conference/web' dev",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "worker:once": "bun apps/worker/src/index.ts --once"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
